<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ═══════════════════════════════════════════════════════════
     BONOLOTO AI PREDICTOR — iOS Info.plist
     ═══════════════════════════════════════════════════════════ -->
<plist version="1.0">
<dict>
    <!-- ─── CONFIGURACIÓN BÁSICA ──────────────────────── -->
    <key>CFBundleDevelopmentRegion</key>
    <string>es</string>
    <key>CFBundleDisplayName</key>
    <string>Bonoloto AI</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>com.bonolotoai.predictor</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>bonoloto_ai</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleVersion</key>
    <string>1</string>

    <!-- ─── PERMISOS ───────────────────────────────────── -->
    <!-- Notificaciones -->
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
        <string>remote-notification</string>
        <string>processing</string>
    </array>

    <!-- Red -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSExceptionDomains</key>
        <dict>
            <!-- Solo permitir HTTPS -->
        </dict>
    </dict>

    <!-- Acceso a archivos para exportación -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Necesario para guardar las combinaciones generadas</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Necesario para guardar las combinaciones generadas en tu galería</string>

    <!-- ─── ORIENTACIÓN ────────────────────────────────── -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- ─── UI ────────────────────────────────────────── -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIMainStoryboardFile</key>
    <string>Main</string>
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleLightContent</string>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>

    <!-- Flutter -->
    <key>NSPrincipalClass</key>
    <string>FlutterApplication</string>

    <!-- ─── LOCALIZACIÓN ──────────────────────────────── -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>es</string>
    </array>
    <key>CFBundleDevelopmentRegion</key>
    <string>es_ES</string>

    <!-- ─── CAPACIDADES ───────────────────────────────── -->
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.bonolotoai.predictor.refresh</string>
        <string>com.bonolotoai.predictor.processing</string>
    </array>
</dict>
</plist>
